# =========================================================================
# GITIGNORE POUR PROJET MINECRAFT FORGE (GRADLE)
# =========================================================================

# --- Gradle & Fichiers de Compilation ---
# Contient les caches de Gradle et les builds compilés
.gradle/
build/
bin/
out/

# --- Dossiers d'Exécution Minecraft (Runtime) ---
# Contient les sauvegardes de mondes (saves), les configs de test et les logs de jeu
run/
run-client/
run-server/
run-gameTestServer/

# --- Fichiers Temporaires & Extraits ---
# Fichiers et dossiers temporaires générés localement ou lors de la décompilation
temp_tax/
META-INF/
forge-sources.jar

# --- Configurations d'IDE / Éditeurs ---
# VS Code (recommandé d'ignorer pour ne pas pousser les réglages personnels)
.vscode/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.settings/
.classpath
.project
*.launch

# --- Fichiers Système, Logs & Crashs ---
Thumbs.db
desktop.ini
.DS_Store
*.log
logs/
crash-reports/
.history/

# --- Secrets & Configurations Locales ---
# Clés API (CurseForge/Modrinth) et chemins locaux (à ne jamais versionner)
.env
local.properties

# --- Dépendances & Binaires ---
*.class

# On ignore tous les fichiers .jar par défaut (comme forge-sources.jar)
*.jar

# SAUF les fichiers .jar dans le dossier 'libs/' car ils contiennent
# vos dépendances de mods locales définies dans build.gradle !
!libs/*.jar

# Le JAR du Gradle Wrapper est indispensable pour lancer gradlew
!gradle/wrapper/gradle-wrapper.jar

# Cependant, on ignore le sous-dossier 'libs/old' qui contient les anciennes versions
libs/old/
